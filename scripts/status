#!/usr/bin/env bash
# scripts/status -> xem tình trạng server + tunnel + web
cd "$(dirname "$0")/.."
URL=$(grep -E '^BASE_URL=' .env 2>/dev/null | cut -d= -f2- | tr -d '\r')
systemctl --user --no-pager --lines=0 status notes-music notes-tunnel | grep -E "●|Active"
curl -s -o /dev/null -w "🌐 $URL -> HTTP %{http_code}\n" --max-time 8 "$URL/login.html"
