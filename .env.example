# ===== Bắt buộc =====
# Địa chỉ public của web (dùng làm redirect URI cho Google)
BASE_URL=https://notes.example.com
# Khóa ký cookie đăng nhập, chuỗi ngẫu nhiên dài:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ===== Đăng nhập Google (để xem playlist YouTube) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email được phép đăng nhập, phân cách bằng dấu phẩy. Để trống = mọi tài khoản (KHÔNG nên)
ALLOWED_EMAILS=you@gmail.com

# ===== Đăng nhập dự phòng bằng mật khẩu (không có playlist) =====
# Để trống = tắt
LOGIN_PASSWORD=

# Số ngày giữ đăng nhập (phiên trượt: cứ dùng web là tự gia hạn)
SESSION_DAYS=180

# ===== Mạng =====
HOST=127.0.0.1
PORT=8000

# ===== Cache / giới hạn =====
# Cache 2 lớp: L1 RAM + L2 Redis. Để trống REDIS_URL = L2 dùng SQLite (data/cache.db), vẫn sống qua restart
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0
CACHE_MAX_MB=3000
MAX_DURATION=10800
# Ngưỡng request tới YouTube (tăng quá dễ bị chặn "not a bot")
EXTRACT_LIMIT=3
CONN_LIMIT=8
SEGMENTS=4

# ===== Tuỳ chọn =====
# File cookies.txt YouTube khi IP server bị chặn
COOKIES_FILE=
# Gợi ý "bài tiếp theo" theo đúng tài khoản YouTube: đặt file cookies.txt (Netscape) của tài khoản
# YouTube vào data/cookies.txt (hoặc trỏ COOKIES_FILE). Không có thì vẫn gợi ý theo gu nghe trong app.
# YT_WRITE=1: nút ♥ trong app bấm "Thích" luôn trên YouTube (cần đăng nhập Google lại để cấp quyền ghi)
YT_WRITE=
# Chỉ dùng cho docker-compose
TUNNEL_TOKEN=
